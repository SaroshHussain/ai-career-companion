# Backend environment example
# Copy this file to `.env` and fill in real values before running in development.

# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai-career-companion

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# AI provider keys
GROQ_KEY=your_groq_api_key_here
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Third-party APIs
JOOBLE_API_KEY=your_jooble_key_here
